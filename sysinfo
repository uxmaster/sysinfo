#!/bin/sh

PUBLIC_IP=0

usage() {
	printf 'usage: sysinfo [-p|--public-ip]\n' >&2
	exit 2
}

ram_usage() {
	pct_used=$(awk '
		/^MemTotal:/     { total = $2 }
		/^MemFree:/      { free = $2 }
		/^Buffers:/      { buffers = $2 }
		/^Cached:/       { cached = $2 }
		/^SReclaimable:/ { sreclaimable = $2 }

		END {
			used = total - free - buffers - cached - sreclaimable
			if (used < 0) used = 0
			printf "%.0f", used / total * 100
		}
	' /proc/meminfo)

	printf "%s%%\n" "$pct_used"
}

swap_usage() {
	awk '
		/^SwapTotal:/ { total = $2 }
		/^SwapFree:/  { free = $2 }
		END {
			if (total > 0)
				printf "%.0f%%\n", (total - free) / total * 100
			else
				print "0%"
		}
	' /proc/meminfo
}

disk_usage() {
	data=$(df --human-readable / | tail -n +2)

	disk_total=$(echo "$data" | awk '{print $2}')
	disk_pct=$(echo "$data" | awk '{print $5}')

	printf "%s of %s\n" "$disk_pct" "$disk_total"
}

processes() {
	count=0
	for process in /proc/[0-9]*; do
		[ -d "$process" ] || continue
		count=$((count + 1))
	done
	printf "%s\n" "$count"
}

system_load() {
	awk '{print $1}' /proc/loadavg
}

network() {
	# Użycie flagi -e w grep jest zgodne z POSIX (zamiast niestandardowego \|)
	interfaces=$(ip -oneline address 2>/dev/null | grep -v -e "host" -e "fe80" | grep -E "inet6?")

	# Przekazujemy zmienną do pętli while bezpiecznym potokiem
	if [ -n "$interfaces" ]; then
		printf "%s\n" "$interfaces" | while read -r interface; do
			[ -z "$interface" ] && continue

			name=$(echo "$interface" | awk '{print $2}')

			# Zamiana grep -P (PCRE) na wbudowane mechanizmy awk - bardzo szybkie i zgodne z POSIX
			ip4=$(echo "$interface" | awk '{for(i=1;i<=NF;i++) if($i=="inet") print $(i+1)}')
			ip6=$(echo "$interface" | awk '{for(i=1;i<=NF;i++) if($i=="inet6") print $(i+1)}')

			[ -n "$ip4" ] && printf "  IPv4 address for %s:|%s\n" "$name" "${ip4%%/*}"
			[ -n "$ip6" ] && printf "  IPv6 address for %s:|%s\n" "$name" "${ip6%%/*}"
		done
	fi
}

public_ipv4() {
	metadata_address=169.254.169.254
	metadata_url="http://$metadata_address/latest/meta-data/public-ipv4"

	# Avoid delaying login on machines without an explicit metadata route.
	ip -4 route show 2>/dev/null | awk -v address="$metadata_address" '
		$1 == address || $1 == address "/32" { found = 1 }
		END { exit !found }
	' || return

	address=$(curl --disable --silent --show-error --fail \
		--noproxy '*' --proto '=http' --connect-timeout 1 --max-time 2 \
		"$metadata_url" 2>/dev/null) || return

	printf '%s\n' "$address" | awk -F. '
		NF != 4 { exit 1 }
		{
			lines++
			for (part = 1; part <= 4; part++) {
				if ($part !~ /^[0-9]+$/ || $part > 255)
					exit 1
			}
		}
		END { if (lines != 1) exit 1 }
	' || return

	printf '%s\n' "$address"
}

logged_in_users() {
	users=$(ss --no-header state established '( sport = :ssh )' 2>/dev/null | awk '{print $5}')
	count=$(echo "$users" | grep -vc "^$")
	printf "%s\n" "$count"
}

uptime_info() {
	uptime_val=""
	mins=""
	hours=""
	days=""

	if [ -f "/proc/uptime" ]; then
		uptime_val=$(cat "/proc/uptime")
		uptime_val=${uptime_val%%.*}
	fi

	if [ -n "$uptime_val" ]; then
		mins=$((uptime_val / 60 % 60))
		hours=$((uptime_val / 3600 % 24))
		days=$((uptime_val / 86400))

		uptime_str="${mins}m"

		[ "$hours" -ne 0 ] && uptime_str="${hours}h $uptime_str"
		[ "$days" -ne 0 ] && uptime_str="${days}d $uptime_str"
	fi

	printf "%s\n" "$uptime_str"
}

main() {
	printf "\n System information as of %s\n\n" "$(/bin/date)"

	template_data="  System load:      |$(system_load)
  Usage of /:       |$(disk_usage)
  Memory usage:     |$(ram_usage)
  Swap usage:       |$(swap_usage)
  Processes:        |$(processes)
  Users logged in:  |$(logged_in_users)"

	network_data=$(network)
	if [ -n "$network_data" ]; then
		template_data="$template_data
$network_data"
	fi

	if [ "$PUBLIC_IP" -eq 1 ]; then
		public_address=$(public_ipv4)
		if [ -n "$public_address" ]; then
			template_data="$template_data
  Public IPv4 address:|$public_address"
		fi
	fi

	printf "%s\n" "$template_data" | awk -F '|' '
		{
			label[NR] = $1
			value[NR] = $2
			if (length($1) > width) width = length($1)
		}
		END {
			for (line = 1; line <= NR; line++)
				printf "%-*s  %s\n", width, label[line], value[line]
		}'

	printf "\nThe uptime of this server is %s.\n\n" "$(uptime_info)"
}

if [ "${SYSINFO_TEST_SOURCE_ONLY:-0}" != 1 ]; then
	case "$#:${1:-}" in
		0:) ;;
		1:-p|1:--public-ip) PUBLIC_IP=1 ;;
		1:-h|1:--help)
			printf 'usage: sysinfo [-p|--public-ip]\n'
			exit 0
			;;
		*) usage ;;
	esac

	main
fi
